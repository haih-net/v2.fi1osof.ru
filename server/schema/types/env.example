# Absolute path (or container mount) containing files referenced by File.path.
# Local development uses /shared/www/fi1osof.ru/agent/uploads in the root .env.
UPLOADS_DIR=uploads

# Optional image generation; both switches must be enabled.
# VITE_* is read at build time. The API key stays on the server.
ALLOW_GENERATE_IMAGES=false
VITE_ALLOW_GENERATE_IMAGES=false
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Генерация изображений теперь использует общий CHAT_API_BASE_URL и CHAT_API_KEY.
# OPENROUTER_API_URL и OPENROUTER_API_KEY выше — прежние настройки, больше не читаются.
