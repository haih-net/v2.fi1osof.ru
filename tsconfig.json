{
  "extends": "./tsconfig.base.json",
  "include": [
    "app/**/*",
    "server/**/*",
    "scripts/chat.ts",
    "*.ts",
    ".react-router/types/**/*",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["node", "vite/client"],
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "rootDirs": [".", ".react-router/types"],
    "baseUrl": ".",
    "paths": {
      "server/*": ["server/*"]
    }
  }
}
