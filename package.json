{
  "name": "haih-site",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "build": "react-router build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/node/index.js",
    "clean": "node -e \"fs.rmSync('build',{recursive:true,force:true});fs.rmSync('.react-router',{recursive:true,force:true})\"",
    "router:gen": "react-router typegen",
    "generate:types": "cross-env NODE_PATH=. tsx app/gql/cli/generateTypes/run",
    "types": "npm run router:gen && tsc --noEmit",
    "types:watch": "npm run router:gen && tsc --noEmit --watch",
    "start": "cross-env NODE_ENV=production node build/node/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check .",
    "storybook": "cross-env STORYBOOK=true storybook dev -p 6006",
    "storybook:build": "cross-env STORYBOOK=true storybook build",
    "monitoring:configure": "node scripts/configure-monitoring.mjs",
    "test:monitoring:failure": "node tests/monitoring/failure-check.mjs",
    "test:monitoring:notifications": "node tests/monitoring/notifications-check.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && vitest run -c vitest.integration.config.cjs",
    "test:integration:watch": "vitest -c vitest.integration.config.cjs",
    "test:integration:stack": "vitest run -c vitest.stack.config.cjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:webkit": "playwright test --project=webkit",
    "e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@apollo/client": "^4.2.0",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@linaria/core": "^8.2.0",
    "@linaria/react": "^8.2.0",
    "@mdxeditor/editor": "^4.0.1",
    "@mdxeditor/gurx": "^1.2.4",
    "@pothos/core": "^4.15.1",
    "@pothos/plugin-simple-objects": "^4.1.4",
    "@prometheus-io/client": "0.16.1",
    "@react-router/express": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "apollo-upload-client": "^20.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.0",
    "graphql-upload-minimal": "^1.6.4",
    "jsonwebtoken": "^9.0.3",
    "katex": "^0.19.0",
    "knex": "^3.3.0",
    "lexical": "^0.35.0",
    "mdast-util-math": "^3.0.0",
    "mermaid": "^12.2.0",
    "micromark-extension-math": "^3.1.0",
    "pg": "^8.23.1",
    "punycode": "2.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "rehype-katex": "^7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "sirv": "3.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/introspection": "^5.0.0",
    "@graphql-codegen/near-operation-file-preset": "^4.0.0",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript": "^5.0.6",
    "@graphql-codegen/typescript-apollo-client-helpers": "^3.0.1",
    "@graphql-codegen/typescript-operations": "^5.0.6",
    "@graphql-codegen/typescript-react-apollo": "^4.3.2",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "^8.4.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/apollo-upload-client": "^19.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/hast": "^3.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/katex": "^0.16.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "22.19.15",
    "@types/pg": "^8.23.1",
    "@types/punycode": "2.1.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.3",
    "@wyw-in-js/vite": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "storybook": "^10.6.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "5.0.3"
  }
}
