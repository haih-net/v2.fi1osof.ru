# COMPOSE_PROJECT_NAME=
# NETWORK_NAME=docker_default

# Runtime environment for app via compose.yaml env_file. Copy to docker/.env.
# Supply the deployment network separately as required by this installation.
AGENTS_CENTER_ENDPOINT=https://ru.panel.fi1osof.ru/api/
# MessageRecipient token; empty disables forwarding. Never use a VITE_ prefix.
AGENTS_CENTER_TOKEN=

# Потоковый чат: серверный API, совместимый с Chat Completions.
CHAT_API_BASE_URL=https://openrouter.ai/api/v1
CHAT_API_KEY=
CHAT_MODEL=google/gemini-3.1-flash-lite-preview
# Необязательная замена системной инструкции помощника.
# CHAT_SYSTEM_PROMPT=

# Wallet sign-in uses JWT_SECRET and the existing User, EthAccount, Token tables.
# openssl rand --hex 20
JWT_SECRET=

# Empty: new wallets require a valid Referrer token. ANY: open wallet registration.
# Existing linked wallets can sign in in either mode.
NEXT_PUBLIC_SITE_SIGNUP_STRATEGY=

# Общий клиент используется чатом, поиском и генерацией изображений.
# Модель поиска по умолчанию совпадает с CHAT_MODEL.
CHAT_WEB_SEARCH_MODEL=
# По умолчанию openrouter:web_search с engine: native.
# Для Polza: CHAT_API_BASE_URL=https://polza.ai/api/v1, ключ Polza
# и CHAT_WEB_SEARCH_TOOL=polza:web_search (без engine: native).
CHAT_WEB_SEARCH_TOOL=

DATABASE_FILENAME=/app/server/database/data/database.sqlite

# Общие настройки почты. При их отсутствии сообщения формы всё равно сохраняются в диалогах.
# Адрес отправителя. Указывайте email без отображаемого имени.
MAIL_FROM=
# Получатель уведомлений; если не задан, используется MAIL_FROM.
MAIL_TO=
# SMTP relay. Без SMTP_HOST используется MX получателя.
SMTP_HOST=
# По умолчанию 587 для SMTP_HOST, иначе 25. Для TLS сразу — 465.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Для локального MailHog: SMTP_HOST=mailhog, SMTP_PORT=1025, SMTP_REQUIRE_TLS=false.
# При запуске приложения вне Docker используйте опубликованный адрес MailHog.
SMTP_REQUIRE_TLS=true

# Local chain: app -> mailserver:25 -> mailhog:1025.
# Set MAIL_FROM=website@example.test and MAIL_TO=feedback@example.net.
# Set SMTP_HOST=mailserver, SMTP_PORT=25, SMTP_REQUIRE_TLS=false;
# leave SMTP_USER and SMTP_PASSWORD empty. See mailserver/README.md.
# External SMTP: use the provider hostname, port, credentials and TLS settings
# above; no mailserver container is required by the application.
MAIL_HOSTNAME=mail.localhost
MAIL_DOMAIN=localhost
# Empty uses [mailhog]:1025 in dev, direct delivery in prod.
MAIL_RELAY_HOST=
# Leave unset to use dev SMTP-only defaults and prod mailbox defaults.
# MAIL_SMTP_ONLY=1
# MAIL_ENABLE_IMAP=0
MAIL_SSL_TYPE=
MAIL_PERMIT_DOCKER=connected-networks
# Published development ports (bound to 127.0.0.1).
MAIL_SMTP_PORT=1026
MAIL_SMTPS_PORT=1465
MAIL_SUBMISSION_PORT=1587
MAIL_IMAP_PORT=1143
MAIL_IMAPS_PORT=1993
MAILHOG_HTTP_PORT=8025
MAILHOG_SMTP_PORT=1025

# Email all administrators with an email address when an agent chat starts
# or a new user message arrives after more than this many hours of inactivity.
# Activity includes agent replies and tool messages. Feedback is unaffected.
# Uses MAIL_FROM and the SMTP settings above; recipients come from User.sudo.
# Defaults: enabled, 3 hours. Set ENABLED=false to disable chat notifications.
# CHAT_EMAIL_NOTIFICATIONS_ENABLED=true
# CHAT_EMAIL_NOTIFICATIONS_INTERVAL_HOURS=3
